{
  "id": "./",
  "name": "Tech Solutions Excel Assistant",
  "short_name": "Excel Assistant",
  "description": "Upload an Excel or CSV file and get filtered tables, totals and charts by typing or speaking a command in Tamil or English. Your data never leaves your computer.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f4f6fb",
  "theme_color": "#1f6feb",
  "lang": "ta",
  "dir": "ltr",
  "orientation": "any",
  "categories": ["productivity", "business", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/screen-1.png", "sizes": "1366x768", "type": "image/png", "form_factor": "wide", "label": "City wise total with chart" },
    { "src": "screenshots/screen-2.png", "sizes": "1366x768", "type": "image/png", "form_factor": "wide", "label": "Filter rows with a Tamil command" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"], "text/csv": [".csv"] } }
  ]
}
